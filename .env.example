# OpenFLO settings. Copy to .env and edit. Never commit .env (it is git-ignored).

# --- Address and certificate (Caddy) -----------------------------------------
# Public DNS name your devices and browser use. DNS-only record (no Cloudflare proxy).
OPENFLO_DOMAIN=openflo.example.com
# HTTPS port devices connect to. Keep 443 unless you have verified another port works.
OPENFLO_HTTPS_PORT=443
# Email Let's Encrypt uses for expiry notices.
OPENFLO_ACME_EMAIL=you@example.com
# Only for compose.dns01.yaml: Cloudflare token with Zone:DNS:Edit on your zone.
CLOUDFLARE_API_TOKEN=
# Image tag to run: a release version such as 0.1.0 (pin it for predictable upgrades), or latest.
OPENFLO_VERSION=latest

# --- Application ----------------------------------------------------------------
# Only pre-fills the address in first-run setup; the saved setting is what devices get.
OPENFLO_PUBLIC_URL=https://openflo.example.com
# true when the server is reachable from the internet (refuses to start without a login).
OPENFLO_PUBLIC=true
# Login method: none, basic, oidc or proxy (see docs/deploy.md, "Sign-in").
OPENFLO_AUTH_MODE=basic
# Optional API token accepted in every mode (for scripts). Changing or clearing it revokes the old one.
OPENFLO_API_TOKEN=
# basic only, optional: the admin from env instead of first-run setup. The hash is argon2; single-quote it.
OPENFLO_ADMIN_USER=
OPENFLO_ADMIN_PASSWORD_HASH=
# OIDC (OPENFLO_AUTH_MODE=oidc): your identity provider's issuer URL, e.g. an Authentik application.
OPENFLO_OIDC_ISSUER=
# OIDC client ID registered for OpenFLO.
OPENFLO_OIDC_CLIENT_ID=
# OIDC client secret registered for OpenFLO.
OPENFLO_OIDC_CLIENT_SECRET=
# Optional comma-separated groups allowed to sign in (empty = any authenticated user).
OPENFLO_OIDC_ALLOWED_GROUPS=
# Proxy auth (OPENFLO_AUTH_MODE=proxy): CIDR of the proxy whose user headers are trusted.
OPENFLO_TRUSTED_PROXY_CIDR=
# true lets the server reset a device directly over your LAN during provisioning.
OPENFLO_LOCAL_DEVICE_ACCESS=false
# Most unknown devices kept waiting to be claimed at once.
OPENFLO_UNCLAIMED_CAP=10
# Time zone for new homes and the 02:30 daily backup (IANA name).
TZ=UTC
